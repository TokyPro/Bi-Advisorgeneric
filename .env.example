# --- Authentification BI Advisor (tous les paramètres sont facultatifs) ---

# Secret de signature des sessions (>= 16 caractères). Si absent, un secret aléatoire est généré
# et stocké dans data/auth-secret. À définir explicitement si vous lancez plusieurs instances.
# AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Dossier des comptes et du journal d'audit (défaut : ./data). Sauvegardez-le.
# BI_DATA_DIR=./data

# Création automatique du premier administrateur au démarrage (sinon : écran de configuration au premier accès)
# ADMIN_EMAIL=admin@votre-domaine.com
# ADMIN_PASSWORD=UnMotDePasseLong2026
# ADMIN_NAME=Administrateur

# Désactive totalement l'authentification (usage local mono-utilisateur UNIQUEMENT)
# AUTH_DISABLED=true

# --- Sécurité des connecteurs ---

# Politique réseau des connexions sortantes (API REST, Airtable, Notion, Odoo, URL de base LLM, bases SQL, MongoDB).
#   public    (défaut) : destinations publiques autorisées ; adresses internes refusées sauf BI_ALLOWED_HOSTS.
#   allowlist          : SEULES les entrées de BI_ALLOWED_HOSTS sont autorisées (recommandé en production).
# Toute autre valeur est traitée comme « allowlist ».
# BI_NETWORK_POLICY=public

# Liste blanche, séparée par des virgules : nom (hote.exemple.com), sous-domaines (*.exemple.com), hote:port,
# IPv4, IPv6 ([fd00::5] ou [fd00::5]:8000), plage CIDR (10.0.0.0/8, fd00::/8). Port facultatif.
# Préférez des IP/CIDR pour les cibles internes. Les adresses link-local / métadonnées cloud (169.254.0.0/16, fe80::/10),
# 0.0.0.0/8, multicast et broadcast restent toujours interdites.
# Exemples : NIM auto-hébergé local, réseau privé, base interne.
# BI_ALLOWED_HOSTS=localhost:8000,10.0.0.0/8,db.interne.local:5432

# Dossier contenant les bases SQLite consultables (fichiers .sqlite, .sqlite3, .db). SQLite est désactivé s'il n'est pas défini.
# Ne JAMAIS pointer vers le dossier data/ (BI_DATA_DIR), ni vers un dossier qui le contient ou qu'il contient.
# BI_SQLITE_DIR=./sqlite
