# --- Authentification BI Advisor ---
# En local (npm run dev / start), tout est facultatif : comptes dans ./data, aucun service externe.
# Sur Vercel (ou BI_HOSTED=true), AUTH_SECRET et une base PostgreSQL sont OBLIGATOIRES (voir README, « Déployer sur Vercel »).

# Secret de signature des sessions, 16 caractères minimum (32 recommandés). Une valeur définie mais plus courte est REFUSÉE.
# En local, si absent : secret aléatoire généré dans data/auth-secret. En hébergé : obligatoire, jamais généré.
# AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Dossier des comptes et du journal d'audit en mode fichier (défaut : ./data). Sauvegardez-le.
# BI_DATA_DIR=./data

# Stockage des comptes : « file » (défaut en local) ou « postgres » (défaut en hébergé). « file » est refusé en hébergé.
# DATABASE_URL seule n'active PAS PostgreSQL en local.
# BI_AUTH_STORE=postgres

# Base PostgreSQL DÉDIÉE aux comptes (jamais une base cliente). BI_AUTH_DATABASE_URL est prioritaire sur DATABASE_URL
# (injectée par l'intégration Neon de Vercel). Utilisez l'URL « pooled » avec sslmode=require.
# BI_AUTH_DATABASE_URL=postgres://utilisateur:motdepasse@hote-factice.example.com/bi_auth?sslmode=require

# Hébergement sans disque persistant hors Vercel (Docker sans volume, Cloud Run…). Sur Vercel : automatique (VERCEL=1).
# BI_HOSTED=true

# Premier administrateur, au choix :
# (a) jeton d'initialisation, 32 caractères minimum, saisi dans l'écran d'initialisation ; à retirer une fois l'admin créé.
#     En hébergé, sans SETUP_TOKEN ni ADMIN_*, l'initialisation est désactivée.
# SETUP_TOKEN=jeton-factice-a-remplacer-0123456789abcdef
# (b) création automatique au premier accès (l'écran d'initialisation n'est alors jamais proposé) ;
#     retirez ADMIN_PASSWORD après le premier démarrage.
# ADMIN_EMAIL=admin@votre-domaine.com
# ADMIN_PASSWORD=UnMotDePasseLong2026
# ADMIN_NAME=Administrateur

# Désactive totalement l'authentification (usage local mono-utilisateur UNIQUEMENT)
# AUTH_DISABLED=true

# --- Sécurité des connecteurs ---

# Politique réseau des connexions sortantes (API REST, Airtable, Notion, Odoo, URL de base LLM, bases SQL, MongoDB).
#   public    (défaut) : destinations publiques autorisées ; adresses internes refusées sauf BI_ALLOWED_HOSTS.
#   allowlist          : SEULES les entrées de BI_ALLOWED_HOSTS sont autorisées (recommandé en production).
# Toute autre valeur est traitée comme « allowlist ».
# BI_NETWORK_POLICY=public

# Liste blanche, séparée par des virgules : nom (hote.exemple.com), sous-domaines (*.exemple.com), hote:port,
# IPv4, IPv6 ([fd00::5] ou [fd00::5]:8000), plage CIDR (10.0.0.0/8, fd00::/8). Port facultatif.
# Préférez des IP/CIDR pour les cibles internes. Les adresses link-local / métadonnées cloud (169.254.0.0/16, fe80::/10),
# 0.0.0.0/8, multicast et broadcast restent toujours interdites.
# Exemples : NIM auto-hébergé local, réseau privé, base interne.
# BI_ALLOWED_HOSTS=localhost:8000,10.0.0.0/8,db.interne.local:5432

# Dossier contenant les bases SQLite consultables (fichiers .sqlite, .sqlite3, .db). SQLite est désactivé s'il n'est pas défini.
# Ne JAMAIS pointer vers le dossier data/ (BI_DATA_DIR), ni vers un dossier qui le contient ou qu'il contient.
# BI_SQLITE_DIR=./sqlite
