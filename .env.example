# --- Authentification BI Advisor (tous les paramètres sont facultatifs) ---

# Secret de signature des sessions (>= 16 caractères). Si absent, un secret aléatoire est généré
# et stocké dans data/auth-secret. À définir explicitement si vous lancez plusieurs instances.
# AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Dossier des comptes et du journal d'audit (défaut : ./data). Sauvegardez-le.
# BI_DATA_DIR=./data

# Création automatique du premier administrateur au démarrage (sinon : écran de configuration au premier accès)
# ADMIN_EMAIL=admin@votre-domaine.com
# ADMIN_PASSWORD=UnMotDePasseLong2026
# ADMIN_NAME=Administrateur

# Désactive totalement l'authentification (usage local mono-utilisateur UNIQUEMENT)
# AUTH_DISABLED=true
